# ─── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ─── Next.js Build Output ────────────────────────────────────
/.next/
/out/
/build

# ─── Environment Variables ───────────────────────────────────
# NEVER commit these — add all secrets here
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Exception: .env.example is safe to commit as a template
!.env.example

# ─── Vercel ──────────────────────────────────────────────────
.vercel

# ─── TypeScript ──────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── OS / Editor Noise ───────────────────────────────────────
.DS_Store
*.pem
Thumbs.db
.idea/
.vscode/*
# Keep VS Code workspace settings
!.vscode/settings.json
!.vscode/extensions.json

# ─── Debug Logs ──────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*